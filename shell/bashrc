#
# The dev-environment bootstrap installs this file.
#
# This is a normal file, not a link. You can edit it.
#
# But the bootstrap replaces it every time it runs, with no backup. Put
# edits you want to keep in ~/.bashrc.local, or in the bootstrap repository.
#

# Run the settings below only in an interactive shell.
case $- in
  *i*) ;;
    *) return;;
esac

# Ubuntu's own .bashrc loads this, and this file replaces Ubuntu's. Without
# the line, you lose tab completion for apt, systemctl, gh, uv and docker.
if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  source /usr/share/bash-completion/bash_completion
fi

# ---------------------------------------------------------------- oh-my-bash

export OSH="${HOME}/.oh-my-bash"

OSH_THEME="powerbash10k"
THEME_SHOW_PYTHON=true
PROMPT_DIRTRIM=5 # Show 5 directory levels. Then trim the root to "...".

OMB_USE_SUDO=true

# Completions are in ~/.oh-my-bash/completions/.
# Your own completions are in ~/.oh-my-bash/custom/completions/.
# Add few. Each completion makes the shell start more slowly.
completions=(
  git
  composer
  ssh
)

# Aliases are in ~/.oh-my-bash/aliases/ and ~/.oh-my-bash/custom/aliases/.
aliases=(
  general
)

# Plugins are in ~/.oh-my-bash/plugins/ and ~/.oh-my-bash/custom/plugins/.
plugins=(
  git
  bashmarks
)

# Check the file first. The shell must still work if oh-my-bash is missing.
if [[ -r "${OSH}/oh-my-bash.sh" ]]; then
  source "${OSH}/oh-my-bash.sh"
fi

# Replace the powerbash10k prompt. This version adds an empty line first.
function __pb10k_ps1 {
  printf "\n%s%s%s" "$(__pb10k_top)" "$(__pb10k_bottom)" "$_omb_prompt_normal"
}

# ------------------------------------------------------------- user config

# mise and uv install tools in this directory.
if [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
  export PATH="${HOME}/.local/bin:${PATH}"
fi

# Do not create __pycache__ directories in the source code.
export PYTHONDONTWRITEBYTECODE=1

# uv manages the Python versions on this machine. This setting stops uv from
# using a system Python instead.
export UV_PYTHON_PREFERENCE=only-managed

export EDITOR="${EDITOR:-vim}"

# --------------------------------------------------------------- AI agents

# The model used for personal work. Change it here, in one place.
export AI_PERSONAL_MODEL="z-ai/glm-5.3-flash"

# Claude Code is the default agent everywhere.
#
# Inside ~/personal it runs on OpenRouter, through "ori". Everywhere else it
# runs on an Anthropic model, as normal. "ori" sets the OpenRouter variables
# for that one run, so nothing else on this machine is affected.
#
# To force the Anthropic model inside ~/personal, type: command claude
claude() {
  if [[ "${PWD}/" == "${HOME}/personal/"* ]] && command -v ori >/dev/null 2>&1
  then
    command ori claude --model "${AI_PERSONAL_MODEL}" "$@"
  else
    command claude "$@"
  fi
}

# Codex stays explicit. To run it on OpenRouter:
#     ori codex --model "$AI_PERSONAL_MODEL"

# Put settings for this machine only in ~/.bashrc.local. For example: tokens,
# proxies, or local paths. The bootstrap never changes that file.
if [[ -r "${HOME}/.bashrc.local" ]]; then
  source "${HOME}/.bashrc.local"
fi

# ------------------------------------------------------------------- mise
#
# Keep this last. mise puts its tools at the start of PATH.
#
# The line is here, and not in [bootstrap.mise_shell_activate], because
# mise copies this whole file as a dotfile. One file cannot have two
# owners: a whole-file copy and a marked block inside the same file. mise
# drops the block and says nothing.

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi
